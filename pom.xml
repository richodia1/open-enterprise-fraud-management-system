<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1.RELEASE</version>
        <relativePath/>
    </parent>

    <groupId>org.openefms</groupId>
    <artifactId>open-enterprise-fraud-management-system</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Open Enterprise Fraud Management System</name>
    <description>Open-source modular enterprise fraud management platform for real-time detection, risk scoring, explainable AI, alerts, and investigations.</description>

    <modules>
        <module>shared/common-models</module>
        <module>shared/common-events</module>
        <module>shared/common-persistence</module>
        <module>services/auth-service</module>
        <module>services/fraud-detection-service</module>
        <module>services/rule-management-service</module>
        <module>services/list-management-service</module>
        <module>services/case-management-service</module>
        <module>api-gateway</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-cloud.version>2025.1.3</spring-cloud.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
