OEFMS_DATASOURCE_USERNAME=openefms
OEFMS_DATASOURCE_PASSWORD=openefms

OEFMS_AUTH_ISSUER=http://localhost:8085
OEFMS_AUTH_BOOTSTRAP_USERNAME=oefms-admin
OEFMS_AUTH_BOOTSTRAP_PASSWORD=openefms-admin
OEFMS_AUTH_BOOTSTRAP_ROLES=PLATFORM_ADMIN,FRAUD_ANALYST
OEFMS_AUTH_BOOTSTRAP_PERMISSIONS=oefms.read,oefms.write,fraud.decision.read,fraud.case.write
OEFMS_AUTH_CLIENT_ID=oefms-platform
OEFMS_AUTH_CLIENT_SECRET=openefms-platform-secret
OEFMS_AUTH_CLIENT_NAME=OEFMS Platform Client
OEFMS_AUTH_CLIENT_REDIRECT_URIS=http://127.0.0.1:8080/login/oauth2/code/oefms-platform
OEFMS_AUTH_CLIENT_POST_LOGOUT_REDIRECT_URIS=http://127.0.0.1:8080/
OEFMS_AUTH_CLIENT_SCOPES=openid,profile,oefms.read,oefms.write,fraud.decision.read,fraud.case.write
OEFMS_AUTH_CLIENT_ACCESS_TOKEN_TTL=PT15M
OEFMS_AUTH_CLIENT_REFRESH_TOKEN_TTL=PT8H
OEFMS_AUTH_CLIENT_REQUIRE_PROOF_KEY=true
OEFMS_AUTH_CLIENT_REQUIRE_AUTHORIZATION_CONSENT=true

OEFMS_RABBITMQ_USERNAME=openefms
OEFMS_RABBITMQ_PASSWORD=openefms
OEFMS_RABBITMQ_VHOST=openefms
OEFMS_RABBITMQ_HOST=localhost
OEFMS_RABBITMQ_PORT=5672
OEFMS_RABBITMQ_EXCHANGE=oefms.events
OEFMS_RABBITMQ_DEAD_LETTER_EXCHANGE=oefms.events.dlx

OEFMS_FRAUD_DECISION_MODE=rules
OEFMS_FRAUD_ML_PROVIDER=disabled
OEFMS_FRAUD_ML_MODEL_NAME=xgboost-baseline
OEFMS_FRAUD_ML_SCORE_THRESHOLD=0.80

POSTGRES_AUTH_DB=openefms_auth
POSTGRES_FRAUD_DB=openefms_fraud
POSTGRES_EXPLAINABLE_AI_DB=openefms_explainable_ai
POSTGRES_RULES_DB=openefms_rules
POSTGRES_LISTS_DB=openefms_lists
POSTGRES_CASES_DB=openefms_cases
